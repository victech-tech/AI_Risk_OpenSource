{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/victech-tech/AI_Risk_OpenSource/rules/rules.schema.json",
  "title": "AI Exposure Check detection rules",
  "description": "Each rules/*.json file is a list of rules. Rules describe what a product can do; they never accuse anyone.",
  "type": "array",
  "items": { "$ref": "#/$defs/rule" },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "vendor", "category", "match", "capabilities", "baseRisk", "summary", "howToTurnOff", "lastReviewed"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "vendor": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": {
          "enum": ["ai-assistant", "ai-agent", "ai-browser-extension", "ai-coding-tool", "remote-access", "monitoring", "other"]
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "description": "Patterns are case-insensitive regular expressions, except extensionId, configTool and packageName, which are exact (case-insensitive) matches.",
          "properties": {
            "installedAppName": { "$ref": "#/$defs/stringList" },
            "processName": { "$ref": "#/$defs/stringList" },
            "extensionId": { "$ref": "#/$defs/stringList" },
            "configTool": { "$ref": "#/$defs/stringList" },
            "packageName": { "$ref": "#/$defs/stringList", "description": "Android package names, for example com.anydesk.anydeskandroid." }
          }
        },
        "capabilities": { "$ref": "#/$defs/capabilityList" },
        "platformCapabilities": {
          "type": "object",
          "description": "Optional. What the product can do on one platform, when that differs from capabilities (for example the phone app cannot run programs).",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "windows": { "$ref": "#/$defs/capabilityList" },
            "mac": { "$ref": "#/$defs/capabilityList" },
            "ios": { "$ref": "#/$defs/capabilityList" },
            "android": { "$ref": "#/$defs/capabilityList" }
          }
        },
        "baseRisk": { "enum": ["low", "medium", "high"] },
        "summary": { "type": "string", "minLength": 20, "maxLength": 400 },
        "howToTurnOff": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "windows": { "type": "string", "minLength": 10 },
            "mac": { "type": "string", "minLength": 10 },
            "ios": { "type": "string", "minLength": 10 },
            "android": { "type": "string", "minLength": 10 }
          }
        },
        "links": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
        "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "capabilityList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["screen", "input-control", "files", "microphone", "camera", "browser-data", "remote-access", "runs-commands", "background", "notifications", "typing", "device-admin"]
      }
    }
  }
}
